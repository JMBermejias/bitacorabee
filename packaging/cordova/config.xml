<?xml version='1.0' encoding='utf-8'?>
<widget id="es.bitacorabee.app" version="@VERSION@" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Bitácora BEE</name>
    <description>Registro de revisiones de apiario</description>
    <author email="apicolanovelda@gmail.com" href="https://github.com/JMBermejias/bitacorabee">
        Jose Manuel Bernabeu Mejias
    </author>
    <content src="index.html" />
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="#f4f2ea" />
    <preference name="AndroidWindowSplashScreenBackground" value="#f2b705" />
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
        <preference name="MixedContentMode" value="always" />
        <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application xmlns:android="http://schemas.android.com/apk/res/android"
                android:usesCleartextTraffic="true" />
        </edit-config>
        <icon density="mdpi" src="res/icon/android/icon-48-mdpi.png" />
        <icon density="hdpi" src="res/icon/android/icon-72-hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/icon-96-xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/icon-144-xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/icon-192-xxxhdpi.png" />
    </platform>
</widget>